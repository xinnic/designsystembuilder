import { describe, it, expect, beforeEach, vi } from 'vitest';
import { useDesignSystem } from '@/state/designSystem';
import type { Tokens, StylingOptions, HapticsConfig } from '@/state/designSystem';

// Helper to wait for async updates
const waitForUpdate = () => new Promise(resolve => setTimeout(resolve, 0));

describe('DesignSystem Store', () => {
  beforeEach(async () => {
    // Reset store to initial state before each test
    const store = useDesignSystem.getState();

    // Reset to defaults synchronously to avoid triggering subscriber loops
    store.setDarkMode(false);
    store.setTheme('turquoise');
    store.setCustomPrimaryColor('#3498db');
    store.setAccentColor('turquoise');
    store.setCustomAccentColor('#1abc9c');
    store.setScale('regular');
    store.setFont('font-jakarta');
    store.setStylePreset('modern');
    store.setSpacingMode('normal');

    // Wait for any subscribers to finish
    await waitForUpdate();
  });

  describe('Store Initialization', () => {
    it('should initialize with default values', () => {
      const state = useDesignSystem.getState();

      expect(state.isDarkMode).toBe(false);
      expect(state.selectedTheme).toBe('turquoise');
      expect(state.selectedScale).toBe('regular');
      expect(state.selectedFont).toBe('font-jakarta');
      expect(state.stylePresetId).toBe('modern');
      expect(state.spacingMode).toBe('normal');
    });

    it('should have valid default tokens', () => {
      const state = useDesignSystem.getState();
      const { tokens } = state;

      expect(tokens.brand).toBeDefined();
      expect(tokens.fontFamily).toBe('Plus Jakarta Sans, ui-sans-serif, system-ui');
      expect(tokens.space).toHaveLength(8);
      expect(tokens.space).toEqual([8, 16, 24, 32, 40, 48, 64, 80]);
    });

    it('should have valid default styling options', () => {
      const state = useDesignSystem.getState();
      const { opts } = state;

      expect(opts.menuLayout).toBe('bottomBar');
      expect(opts.cardBorderWeight).toBe('thin');
      expect(opts.inputStyle).toBe('filled');
    });

    it('should have valid default haptics config', () => {
      const state = useDesignSystem.getState();
      const { haptics } = state;

      expect(haptics.enabled).toBe(true);
      expect(haptics.stack).toBe('web-react');
      expect(haptics.tapLight).toBe('selection');
    });
  });

  describe('Token Setters', () => {
    it('should update tokens partially', () => {
      const store = useDesignSystem.getState();
      const originalBrand = store.tokens.brand;

      store.setTokens({ brand: '255 0 0' });

      expect(store.tokens.brand).toBe('255 0 0');
      expect(store.tokens.fontFamily).toBeDefined(); // Other tokens unchanged
    });

    it('should merge multiple token updates', () => {
      const store = useDesignSystem.getState();

      store.setTokens({
        brand: '100 100 100',
        success: '0 255 0'
      });

      expect(store.tokens.brand).toBe('100 100 100');
      expect(store.tokens.success).toBe('0 255 0');
    });

    it('should update typography tokens', () => {
      const store = useDesignSystem.getState();

      store.setTokens({
        h1: { size: '32px', line: '40px', weight: 800 }
      });

      expect(store.tokens.h1.size).toBe('32px');
      expect(store.tokens.h1.line).toBe('40px');
      expect(store.tokens.h1.weight).toBe(800);
    });
  });

  describe('Options Setters', () => {
    it('should update styling options partially', () => {
      const store = useDesignSystem.getState();

      store.setOpts({ menuLayout: 'hamburger' });

      expect(store.opts.menuLayout).toBe('hamburger');
      expect(store.opts.cardBorderWeight).toBe('thin'); // Unchanged
    });

    it('should update multiple options', () => {
      const store = useDesignSystem.getState();

      store.setOpts({
        cardBorderWeight: 'thick',
        inputStyle: 'outlined'
      });

      expect(store.opts.cardBorderWeight).toBe('thick');
      expect(store.opts.inputStyle).toBe('outlined');
    });

    it('should handle logo upload', () => {
      const store = useDesignSystem.getState();
      const logoUrl = 'data:image/png;base64,test';

      store.setOpts({ logo: logoUrl });

      expect(store.opts.logo).toBe(logoUrl);
    });
  });

  describe('Haptics Setters', () => {
    it('should update haptics configuration', () => {
      const store = useDesignSystem.getState();

      store.setHaptics({ enabled: false });

      expect(store.haptics.enabled).toBe(false);
    });

    it('should update haptics stack', () => {
      const store = useDesignSystem.getState();

      store.setHaptics({ stack: 'react-native-expo' });

      expect(store.haptics.stack).toBe('react-native-expo');
    });
  });

  describe('Theme Management', () => {
    it('should change theme color', () => {
      const store = useDesignSystem.getState();

      store.setTheme('emerald');

      expect(store.selectedTheme).toBe('emerald');
    });

    it('should handle custom theme color', () => {
      const store = useDesignSystem.getState();

      store.setTheme('custom');
      store.setCustomPrimaryColor('#ff0000');

      expect(store.selectedTheme).toBe('custom');
      expect(store.customPrimaryColor).toBe('#ff0000');
    });

    it('should update accent color', () => {
      const store = useDesignSystem.getState();

      store.setAccentColor('emerald');

      expect(store.selectedAccentColor).toBe('emerald');
    });

    it('should handle custom accent color', () => {
      const store = useDesignSystem.getState();

      store.setAccentColor('custom');
      store.setCustomAccentColor('#00ff00');

      expect(store.selectedAccentColor).toBe('custom');
      expect(store.customAccentColor).toBe('#00ff00');
    });
  });

  describe('Dark Mode', () => {
    it('should toggle dark mode on', () => {
      const store = useDesignSystem.getState();

      store.setDarkMode(true);

      expect(store.isDarkMode).toBe(true);
    });

    it('should toggle dark mode off', () => {
      const store = useDesignSystem.getState();

      store.setDarkMode(true);
      store.setDarkMode(false);

      expect(store.isDarkMode).toBe(false);
    });

    it('should update text colors in dark mode', async () => {
      const store = useDesignSystem.getState();

      // Get initial light mode colors
      const lightTextPrimary = store.tokens.textPrimary;

      // Switch to dark mode
      store.setDarkMode(true);

      // Wait for subscriber to run
      await waitForUpdate();
      const darkTextPrimary = store.tokens.textPrimary;

      expect(darkTextPrimary).not.toBe(lightTextPrimary);
      expect(darkTextPrimary).toBe('225 225 225'); // Dark mode text color
    });

    it('should update background colors in dark mode', async () => {
      const store = useDesignSystem.getState();

      store.setDarkMode(true);

      // Wait for subscriber to run
      await waitForUpdate();

      expect(store.tokens.bgPrimary).toBe('18 18 18');
      expect(store.tokens.bgSecondary).toBe('30 30 30');
    });
  });

  describe('Typography Scale', () => {
    it('should change to small scale', async () => {
      const store = useDesignSystem.getState();

      store.setScale('small');
      await waitForUpdate();

      expect(store.selectedScale).toBe('small');
      expect(store.tokens.h1.size).toBe('24px');
      expect(store.tokens.body.size).toBe('14px');
    });

    it('should change to large scale', async () => {
      const store = useDesignSystem.getState();

      store.setScale('large');
      await waitForUpdate();

      expect(store.selectedScale).toBe('large');
      expect(store.tokens.h1.size).toBe('36px');
      expect(store.tokens.body.size).toBe('18px');
    });

    it('should maintain regular scale', async () => {
      const store = useDesignSystem.getState();

      store.setScale('regular');
      await waitForUpdate();

      expect(store.selectedScale).toBe('regular');
      expect(store.tokens.h1.size).toBe('28px');
      expect(store.tokens.body.size).toBe('16px');
    });

    it('should update all typography levels when scale changes', async () => {
      const store = useDesignSystem.getState();

      store.setScale('small');
      await waitForUpdate();

      expect(store.tokens.h1.size).toBe('24px');
      expect(store.tokens.h2.size).toBe('20px');
      expect(store.tokens.subhead.size).toBe('16px');
      expect(store.tokens.caption.size).toBe('12px');
    });
  });

  describe('Font Family', () => {
    it('should change font family', async () => {
      const store = useDesignSystem.getState();

      store.setFont('font-vietnam');
      await waitForUpdate();

      expect(store.selectedFont).toBe('font-vietnam');
      expect(store.tokens.fontFamily).toBe('Be Vietnam Pro, ui-sans-serif, system-ui');
    });

    it('should handle multiple font families', async () => {
      const store = useDesignSystem.getState();

      const fontTests = [
        { id: 'font-jakarta', family: 'Plus Jakarta Sans, ui-sans-serif, system-ui' },
        { id: 'font-wix', family: 'Wix Madefor Text, ui-sans-serif, system-ui' },
        { id: 'font-figtree', family: 'Figtree, ui-sans-serif, system-ui' },
        { id: 'font-albert', family: 'Albert Sans, ui-sans-serif, system-ui' },
        { id: 'font-satoshi', family: 'Satoshi, ui-sans-serif, system-ui' }
      ];

      for (const { id, family } of fontTests) {
        store.setFont(id);
        await waitForUpdate();
        expect(store.tokens.fontFamily).toBe(family);
      }
    });
  });

  describe('Spacing Mode', () => {
    it('should change to compact spacing', async () => {
      const store = useDesignSystem.getState();

      store.setSpacingMode('compact');
      await waitForUpdate();

      expect(store.spacingMode).toBe('compact');
      expect(store.tokens.space).toEqual([4, 8, 12, 16, 20, 24, 32, 40]);
    });

    it('should change to comfortable spacing', async () => {
      const store = useDesignSystem.getState();

      store.setSpacingMode('comfortable');
      await waitForUpdate();

      expect(store.spacingMode).toBe('comfortable');
      expect(store.tokens.space).toEqual([12, 24, 36, 48, 60, 72, 96, 120]);
    });

    it('should maintain normal spacing', async () => {
      const store = useDesignSystem.getState();

      store.setSpacingMode('normal');
      await waitForUpdate();

      expect(store.spacingMode).toBe('normal');
      expect(store.tokens.space).toEqual([8, 16, 24, 32, 40, 48, 64, 80]);
    });
  });

  describe('Style Presets', () => {
    it('should change style preset', () => {
      const store = useDesignSystem.getState();

      store.setStylePreset('minimal');

      expect(store.stylePresetId).toBe('minimal');
    });

    it('should handle different preset IDs', () => {
      const store = useDesignSystem.getState();

      const presets = ['modern', 'minimal', 'bold', 'soft'];

      presets.forEach(preset => {
        store.setStylePreset(preset);
        expect(store.stylePresetId).toBe(preset);
      });
    });
  });

  describe('Color System Updates', () => {
    it('should update brand color when theme changes', async () => {
      const store = useDesignSystem.getState();

      store.setTheme('emerald');
      await waitForUpdate();

      // The subscriber should update the brand token
      expect(store.tokens.brand).toBeDefined();
      expect(typeof store.tokens.brand).toBe('string');
      expect(store.tokens.brand.split(' ')).toHaveLength(3); // RGB triplet
    });

    it('should use custom color when theme is custom', async () => {
      const store = useDesignSystem.getState();

      store.setTheme('custom');
      store.setCustomPrimaryColor('#ff0000');

      // Wait for subscriber to run
      await waitForUpdate();
      const brand = store.tokens.brand;
      expect(brand).toBe('255 0 0'); // Red in RGB triplet
    });
  });
});
